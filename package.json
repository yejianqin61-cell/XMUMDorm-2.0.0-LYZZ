{
  "name": "jack-campus-social",
  "version": "1.0.0",
  "description": "校园社交网站 - 包含社交功能和食堂系统",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:web": "cd frontend && npm run dev",
    "import-products": "node scripts/bulk-import-products.js",
    "migrate:all": "node scripts/run-migrations-all.js",
    "migrate:admin": "node scripts/apply-sql-file.js migrations/056_admin_system.sql && node scripts/apply-sql-file.js migrations/057_user_status.sql",
    "migrate:ads": "node scripts/run-migration-062-063-advertisements.js",
    "migrate:materials": "node scripts/run-migration-069-materials.js",
    "migrate:square": "node scripts/run-migrations-041-045.js",
    "migrate:title": "node scripts/run-migration-013-title.js",
    "migrate:title:railway": "node scripts/migrate-railway-013-posts-title-safe.js",
    "migrate:perf:railway": "node scripts/migrate-railway-014-perf-indexes-safe.js",
    "backfill:post-thumbs": "node scripts/backfill-post-thumbs.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "build:web": "cd frontend && npm run build"
  },
  "keywords": [
    "campus",
    "social",
    "canteen"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^8.0.2",
    "sanitize-html": "^2.17.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
