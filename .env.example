# ========== 数据库（二选一）==========
# 本地：只填下面 DB_*，DB_NAME 一般为 jack_campus；不要填 MYSQL_URL，否则会连到云上。
# 云上 / Railway：填 DATABASE_URL 或 MYSQL_URL（库名在链接末尾，常见为 .../railway）。
# 若同时存在 MYSQL_URL 与 DB_NAME：迁移脚本以「连接串里的库名」为准，避免误连到不存在的 jack_campus。
# PORT=4040
# NODE_ENV=development
# 本地开发建议保持关闭，否则会每分钟跑任务查库/发推送，容易感觉“很卡”
# ENABLE_BACKGROUND_JOBS=1
# ========== 性能调试 / 缓存（可选）==========
# 低成本先加“进程内缓存”，对 tags/regions/排行榜 这种读多写少接口会立刻见效
# CACHE_TAGS_TTL_MS=300000
# CACHE_REGIONS_TTL_MS=600000
# CACHE_RANKINGS_TTL_MS=30000
# 慢日志阈值（用于定位卡顿）
# LOG_SLOW_SQL_MS=250
# LOG_SLOW_API_MS=400
# JWT_SECRET=请改为随机长串
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=jack_campus
# DATABASE_URL=
# MYSQL_URL=

# Object Storage (S3 compatible): Cloudflare R2 / AWS S3 / COS / OSS
# Public read is recommended via bucket policy + CDN.
# 重要：商品/帖子等图片上传到对象存储后，接口用此地址生成图片 URL。
# 本地开发也必须配置此项，否则返回 /uploads/xxx 会访问本地静态目录（无文件），图片 404 看不到。
PUBLIC_ASSET_BASE_URL=https://pub-62ee299bb18a4fb0a9819dd8a73a8603.r2.dev
OBJECT_STORAGE_ENDPOINT=https://9bcb1de061419f70838c6e2b3957ed7c.r2.cloudflarestorage.com/jack-dorm-assets
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# For many S3-compatible providers (e.g., R2) path-style is often required.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# 商城商品图复用上方对象存储，PUBLIC_ASSET_BASE_URL 必须是可公开读取的 HTTPS 前缀。
# 无对象存储时，本地默认 .local/shop-assets；生产必须实际挂载持久卷并填写下方目录。
# 仅设置目录不等于已挂载持久卷，生产禁止静默回退到临时目录。
SHOP_ASSET_DIR=
# 默认 auto：077 结构完整后自动开放，无需在部署平台新增变量；不自动迁移。
# 关闭仅禁止新发券/新用券，已有优惠订单仍需兼容处理。
SHOP_COUPONS_ENABLED=auto

# 未上传图片的商品占位路径（需与前端 static 资源一致，默认 /products/default.png）
# DEFAULT_PRODUCT_IMAGE_PATH=/products/default.png

# ========== Web Push（课前提醒，可选）==========
# 生成：npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 合规联系地址，建议 mailto: 你的邮箱
# VAPID_SUBJECT=mailto:you@example.com
# 课前提醒的「第几周」现在由 shared/config/semesters.js 自动跟进（不再用环境变量）。
# 换学期时改那个文件的 SEMESTERS 即可，前端课表页与提醒任务共用同一份日历。

# 邮件发送（二选一）
# 方案 A - Resend API（推荐生产/ Railway）：走 HTTPS，无 SMTP 端口限制。见 .env.resend.example
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Dorm <onboarding@resend.dev>
# 方案 B - SMTP（本地/自建）：见 .env.smtp.example
# SMTP_HOST=... SMTP_USER=... SMTP_PASS=... SMTP_FROM=...

# ========== 协作者生产数据只读预览（可选）==========
# 仅部署端填写；PREVIEW_DATABASE_URL 必须是只读账号或只读副本，不能复用 DATABASE_URL。
# PREVIEW_DATABASE_URL=
# PREVIEW_GATEWAY_TOKENS=alice:<sha256>,bob:<sha256>
# PREVIEW_ALLOWED_ORIGINS=http://localhost:5173
#
# 协作者只在 frontend/.env.local 中填写下面四项；前三项没有 VITE_ 前缀，不会进入浏览器 bundle。
# PREVIEW_GATEWAY_URL=https://your-production-api.example
# PREVIEW_GATEWAY_TOKEN=<their-raw-token>
# PREVIEW_GATEWAY_ORIGIN=http://localhost:5173

# ========== 校园助手（可选，服务端配置）==========
# CAMPUS_AGENT_URL=http://127.0.0.1:8001
# CAMPUS_AGENT_SHARED_SECRET=<独立生成的至少32字符随机密钥，不复用JWT_SECRET>
# 配套 Campus Copilot 服务使用相同 CAMPUS_AGENT_SHARED_SECRET，并设置
# XMUMDORM_API_URL=https://your-dorm-api.example
# 这些密钥和服务端地址不能添加 VITE_ 前缀；未配置时助手接口返回 503。
