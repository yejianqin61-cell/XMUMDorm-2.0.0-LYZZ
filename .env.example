# ========== 数据库（二选一）==========
# 本地：只填下面 DB_*，DB_NAME 一般为 jack_campus；不要填 MYSQL_URL，否则会连到云上。
# 云上 / Railway：填 DATABASE_URL 或 MYSQL_URL（库名在链接末尾，常见为 .../railway）。
# 若同时存在 MYSQL_URL 与 DB_NAME：迁移脚本以「连接串里的库名」为准，避免误连到不存在的 jack_campus。
# PORT=4040
# NODE_ENV=development
# 本地开发建议保持关闭，否则会每分钟跑任务查库/发推送，容易感觉“很卡”
# ENABLE_BACKGROUND_JOBS=1
# ========== 性能调试 / 缓存（可选）==========
# 低成本先加“进程内缓存”，对 tags/regions/排行榜 这种读多写少接口会立刻见效
# CACHE_TAGS_TTL_MS=300000
# CACHE_REGIONS_TTL_MS=600000
# CACHE_RANKINGS_TTL_MS=30000
# 慢日志阈值（用于定位卡顿）
# LOG_SLOW_SQL_MS=250
# LOG_SLOW_API_MS=400
# JWT_SECRET=请改为随机长串
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=jack_campus
# DATABASE_URL=
# MYSQL_URL=

# Object Storage (S3 compatible): Cloudflare R2 / AWS S3 / COS / OSS
# Public read is recommended via bucket policy + CDN.
# 重要：商品/帖子等图片上传到对象存储后，接口用此地址生成图片 URL。
# 本地开发也必须配置此项，否则返回 /uploads/xxx 会访问本地静态目录（无文件），图片 404 看不到。
PUBLIC_ASSET_BASE_URL=https://pub-62ee299bb18a4fb0a9819dd8a73a8603.r2.dev
OBJECT_STORAGE_ENDPOINT=https://9bcb1de061419f70838c6e2b3957ed7c.r2.cloudflarestorage.com/jack-dorm-assets
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# For many S3-compatible providers (e.g., R2) path-style is often required.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# 未上传图片的商品占位路径（需与前端 static 资源一致，默认 /products/default.png）
# DEFAULT_PRODUCT_IMAGE_PATH=/products/default.png

# ========== Web Push（课前提醒，可选）==========
# 生成：npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 合规联系地址，建议 mailto: 你的邮箱
# VAPID_SUBJECT=mailto:you@example.com
# 课前提醒的「第几周」现在由 shared/config/semesters.js 自动跟进（不再用环境变量）。
# 换学期时改那个文件的 SEMESTERS 即可，前端课表页与提醒任务共用同一份日历。

# 邮件发送（二选一）
# 方案 A - Resend API（推荐生产/ Railway）：走 HTTPS，无 SMTP 端口限制。见 .env.resend.example
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Dorm <onboarding@resend.dev>
# 方案 B - SMTP（本地/自建）：见 .env.smtp.example
# SMTP_HOST=... SMTP_USER=... SMTP_PASS=... SMTP_FROM=...

# ========== 学习资料模块 M10（可选）==========
# 资料本体存放在**独立的公开 GitHub 仓库**，前端直连 CDN 读字节（零服务器带宽）；
# 上传/改元数据/下架等写操作经本后端代理 GitHub API。
# 未配置时：模块优雅降级（列表返回 configured=false，上传返回 503），不影响其它功能。
#
# 资料库仓库（必须 public，否则浏览器读不到内容）
GITHUB_MATERIALS_OWNER=James898-boom
GITHUB_MATERIALS_REPO=Xmum-opensource
GITHUB_MATERIALS_BRANCH=main
GITHUB_MATERIALS_CDN_BASE=https://cdn.jsdelivr.net/gh

# ⚠️ fine-grained PAT：Repository access 仅选上面这一个仓库；
#    Repository permissions 需要 Contents: Read and write + Pull requests: Read and write。
#    **不要**授予 Workflows 权限（后端不需要改 CI；.github/workflows 由人工在网页端维护）。
#    ⚠️ 绝不提交到 Git；绝不通过任何接口下发前端。
GITHUB_MATERIALS_TOKEN=

# 功能开关与限额
# MATERIALS_ENABLED=1                 # 0 = 应急暂停受理新上传（无需发版即可停写）
# MATERIALS_MAX_FILE_MB=20            # 单文件上限；实测 jsDelivr 上限恰为 20 MiB
# MATERIALS_UPLOAD_ROLE=student       # student = 全体登录用户可传；admin = 仅管理员
# MATERIALS_UPLOAD_PER_HOUR=5         # 单用户每小时上传次数
# MATERIALS_INDEX_CACHE_MS=30000      # index.json 短缓存（写入前会强制刷新）
# MATERIALS_BLOB_RETRIES=4            # 大 blob 上传退避重试次数（实测偶发 502）
# MATERIALS_GITHUB_TIMEOUT_MS=60000   # 单次 GitHub 请求超时
