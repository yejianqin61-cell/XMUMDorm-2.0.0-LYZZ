{
  "name": "xmumdorm-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci",
    "doctor": "expo-doctor",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "rulers": "npm run rulers:debt && npm run rulers:contrast && npm run rulers:brand && npm run rulers:tokens",
    "rulers:debt": "node ../scripts/design-debt-report.js --path ./src --fail-on-zero",
    "rulers:contrast": "node ../scripts/contrast-check.js --file ../tokens/generated/tokens.check.json --fail",
    "rulers:brand": "node ../scripts/brand-ramp.js --hue 261.2 --fail",
    "rulers:tokens": "node ../scripts/gen-tokens.js --check",
    "verify": "npm run typecheck && npm run test:ci && npm run rulers"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.13",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
