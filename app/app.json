{
  "expo": {
    "name": "厦马小筑",
    "slug": "xmumdorm",
    "scheme": "xmumdorm",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow photo selection for dish reviews",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow photo access when required by the system",
          "savePhotosPermission": "Allow saving the current treehole image to Photos",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f8fa",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 256,
          "dark": {
            "backgroundColor": "#12141a"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xmumdorm.app"
    },
    "android": {
      "package": "com.xmumdorm.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
